    function viewNotesAccordingToDateEmpProj(startDateYear, startDateMonth, startDateDate, endDateYear, endDateMonth, endDateDate, emp_id, proj_id, emp_name) {
      swall("Please wait...");
      $.ajax({
        type: 'POST',
        url: `/admin/report/view/employee/notes?fromStartYear=${startDateYear}&fromStartMonth=${startDateMonth}&fromStartDate=${startDateDate}&toEndYear=${endDateYear}&toEndMonth=${endDateMonth}&toEndDate=${endDateDate}&emp_id=${emp_id}&proj_id=${proj_id}&emp_name=${emp_name}`,
        dataType: "json",
        data: {
        },
        success: function(result) {
          //- console.log(result);
          if (result.code == 200) {
            swal.close();
            //- tbl.clear().rows.add(result.data.newArr).draw();
            $.fancybox.open(`
              <div class="card">
                <div class="card-header">
                  <div class="card-head-row">
                    <div class="card-title">${emp_name}</div>
                  </div>
                  <div class="">
                    <span class="badge badge-primary badge-pill">View all notes</span>
