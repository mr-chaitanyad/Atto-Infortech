                    <div class="card-title">${emp_name}</div>
                  </div>
                  <div class="">
                    <span class="badge badge-primary badge-pill">View all notes</span>
                  </div>
                </div>
                <div class="card-body">
                ${(result.data).map((each, index) => `
                  <div class="d-flex">
                    ${each.notes ? `
                      <div class="flex-1 ml-3 pt-1" style="background-color: #58ff84;">
                        <h6 id="id_${index}" class="fw-bold mb-1">
