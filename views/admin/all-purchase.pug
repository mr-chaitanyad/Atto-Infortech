    function reverseOrderModal(packages, reverse_order, purchase_id) {
      $.fancybox.close();
      var SweetAlert2Demo = function () {
          var initDemos = function () {
            swal({
              title: 'Are you sure?',
              text: "You won't be able to revert this!",
              icon: 'warning',
              buttons:{
                cancel: {
                  visible: true,
                  text : 'No, cancel!',
                  className: 'btn mr-2 btn-black'
                },
                confirm: {
                  text : 'Reverse all order',
                  className : 'btn btn-primary'
                }
              }
            }).then((willDelete) => {
              if (willDelete) {
                $.ajax({
                  type: 'POST',
                  url: '/admin/package/reverse/all',
                  data: {
                    mainObj: JSON.parse(packages),
                    is_reverse: reverse_order,
                    purchase_id: purchase_id
                  },
                  success: function (result) {
                    console.log('success');
                    if (result.type == 'success') {
                      swal("Order reversed successfully!", {
                        icon: "success",
                        buttons : {
                          confirm : {
                            className: 'btn btn-primary'
                          }
                        }
                      }).then(success => {
                        if (success) {
                          window.location.reload();
                          return;
                        }
                      });
                    } else if (result.type == 'error' && result.code == '400') {
                      swal("This order already has been reversed!", {
                        buttons: false,
                        timer: 2000,
                        backdrop:true,
                        closeOnClickOutside: false,
                        closeOnEsc: false
                      });
                    } else if (result.type == 'error' && result.code == '500') {
                      swal("Something went wrong!", {
                        buttons: false,
                        timer: 1500,
                        backdrop:true,
                        closeOnClickOutside: false,
                        closeOnEsc: false
                      });
                    }
                  }
                })
              } else {
                swal("Reverse order has been canceled!", {
                  buttons: false,
                  timer: 1500,
                  backdrop:true,
                  closeOnClickOutside: false,
                  closeOnEsc: false
                });
                return;
              }
            });
          };
          return {
              //== Init
              init: function () {
                initDemos();
              },
            };
          }();
        jQuery(document).ready(function () {
          SweetAlert2Demo.init();
        });
    }

    function reverseEach(product_name, input_qty, product_id, warehouse_id, package_id, price, total_amt) {
      //- alert(package_id);
      //- return;
      $.fancybox.close();
      var SweetAlert2Demo = function () {
        var initDemos = function () {
          swal({
            onOpen: function () {
              alert('heyy');
              swal.disableConfirmButton();
            },
            title: `Reverse ${product_name} Order`,
            text: `Your input cannot be more than ${input_qty} qty.`,
            html: `<br><input class="form-control" onkeyup="checkNumber('${input_qty}')" placeholder="Enter qty" id="swal-input">`,
            content: {
              element: "input",
              onkeyup: `checkNumber('${input_qty}')`,
              attributes: {
                placeholder: "Enter qty",
                value: input_qty,
                type: "text",
                id: "swal-input",
                className: "form-control",
              },
            },
            buttons: {
              cancel: {
                visible: true,
                text : 'No, cancel!',
                className: 'btn mr-2 btn-black'
              },
              confirm: {
                text : 'Yes, Reverse!',
                className : 'btn btn-primary'
              }
            },
          }).then(
          function(reverse) {
            //- swal("", "You entered : " + $('#swal-input').val(), "success");
              if (reverse) {
                if (isNaN($('#swal-input').val())) {
                  alert('Your input is not a number! Try again.');
                  return;
                } else if (parseInt($('#swal-input').val()) > parseInt(input_qty)) {
                  alert('Your input is more than the quantity! Try again.');
                  return;
                } else if ($('#swal-input').val().includes('.') || $('#swal-input').val().includes('-') || $('#swal-input').val().includes('+')) {
                  alert('This is not a valid number! Try again.');
                  return;
                }
                //- swal("", "You entered : " + $('#swal-input').val(), "success");
                $.ajax({
                  type: 'POST',
                  url: '/admin/package/reverse/one',
                  data: {
                    product_id,
                    warehouse_id,
                    input_qty: $('#swal-input').val(),
                    available_qty: input_qty,
                    package_id,
                    price,
                    total_amt
                  },
                  success: function (result) {
                    if (result.type == 'success') {
                      swal("Order reversed successfully!", {
                        icon: "success",
                        buttons : {
                          confirm : {
                            className: 'btn btn-primary'
                          }
                        }
                      }).then(success => {
                        if (success) {
                          window.location.reload();
                          return;
                        }
                      });
                    } else if (result.type == 'error' && result.code == '500') {
                      swal("Something went wrong!", {
                        buttons: false,
                        timer: 1500,
                        backdrop:true,
                        closeOnClickOutside: false,
                        closeOnEsc: false
                      });
                    }
                  }
                })
              } else {
                swal("Reverse order has been canceled!", {
                  buttons: false,
                  timer: 1500,
                  backdrop:true,
                  closeOnClickOutside: false,
                  closeOnEsc: false
                });
                return;
              }
            }
          )
        };
        return {
            //== Init
            init: function () {
              initDemos();
            },
          };
        }();
      jQuery(document).ready(function () {
        SweetAlert2Demo.init();
      });
    }

