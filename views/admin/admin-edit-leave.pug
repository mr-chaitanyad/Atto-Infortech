extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold Add Leave
              h5.text-white.op-7.mb-2 Welcome to Atto Infotech
      .page-inner
        .row
          .col-md-12
            .card.card-with-nav
              form(action="/admin/leave/admin/create", method="POST")
                .card-body
                  .col-md-12
                    label(for='exampleFormControlSelect') Select Employee
                    select#dropdown1.form-control.select2(name='emp_id' class="sel_proj" required)
                      option(value='') Select Employee
                      each user in users
                        option(value=user._id) #{user.name}
                .card-body
                  .col-md-12
                    label(for='exampleFormControlSelect') From date
                    input.form-control(type='text' name='leave_start' value='' required='')
                .card-body
                  .col-md-12
                    label(for='exampleFormControlSelect') to date
                    input.form-control(type='text' name='leave_end' value='' required='')
                .card-body
                  .col-md-12
                    label(for='exampleFormControlSelect') Reason
                    textarea#mention_task(name='leave_reason' style='width:100%;height:200px;max-width:100%;max-height:100px')

                  .card-action
                    .row
                      .col-md-12
                        button.btn.btn-primary(type="submit") Add Leave
                .row
  block script
    script(type='text/javascript' src='https://cdn.jsdelivr.net/momentjs/latest/moment.min.js')
    script(type='text/javascript' src='https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js')

  script.
    $('input[name="leave_start"]').daterangepicker({
      startDate: moment(),
      singleDatePicker: true,
      showDropdowns: true,
      locale: {
        format: 'DD-MM-YYYY'
      },
      maxYear: parseInt(moment().format('YYYY'),10),
      autoApply: true
    });
    $('input[name="leave_end"]').daterangepicker({
      startDate: moment(),
      singleDatePicker: true,
      locale: {
        format: 'DD-MM-YYYY'
      },
      maxYear: parseInt(moment().format('YYYY'),10),
      autoApply: true
    });

