extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold Renew product
              h5.text-white.op-7.mb-2 Welcome to Admin Panel
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/dashboard') Dashboard
      .page-inner
        .row
          .col-md-6
            .card.card-with-nav
              .card-body
                //- +searchUsers()
                //- pre= h.dump(renews)
                .table-responsive
                  .col-sm-12
                    table#multi-filter-select.display.table.table-striped.table-hover.dataTable(role='grid', aria-describedby='basic-datatables_info')
                      thead
                        tr(role='row')
                          th Product Name
                          //- th Threshold qty
                          //- th Total qty
                          //- th Type
                          th Qty finished on
                          th Action
                      tbody
                        each renew in renewsOn
                          a(href="#")
                            tr.odd(role='row' style=`background-color: ${renew.is_renew == 0 ? 'rgba(255, 159, 0, 1)' : ''}`)
                              td.sorting_1 #{renew.product_id.name}
                              //- td #{renew.product_id.threshold}
                              //- td #{renew.product_id.total_qty}
                              //- td #{renew.product_id.is_spare}
                              td #{renew.createdAt.toString().split(" ").slice(0,5).join(" ")}
                              td
                                input.renew(type='checkbox', checked=(renew.is_renew == 0 ? false : true), data-toggle='toggle', data-onstyle='primary', data-style='btn-round', id=renew._id)
                .row
          .col-md-6
            .card.card-with-nav
              .card-body
                //- +searchUsers()
                //- pre= h.dump(renews)
                .table-responsive
                  .col-sm-12
                    table#multi-filter-selectt.display.table.table-striped.table-hover.dataTable(role='grid', aria-describedby='basic-datatables_info')
                      thead
                        tr(role='row')
                          th Product Name
                          //- th Threshold qty
                          //- th Total qty
                          //- th Type
                          th Qty finished on
                          th Action
                      tbody
                        each renew in renewsOff
                          a(href="#")
                            tr.odd(role='row' style=`background-color: ${renew.is_renew == 0 ? 'rgba(255, 159, 0, 1)' : ''}`)
                              td.sorting_1 #{renew.product_id.name}
                              //- td #{renew.product_id.threshold}
                              //- td #{renew.product_id.total_qty}
                              //- td #{renew.product_id.is_spare}
                              td #{renew.createdAt.toString().split(" ").slice(0,5).join(" ")}
                              td
                                input.reneww(type='checkbox', checked=(renew.is_renew == 0 ? false : true), data-toggle='toggle', data-onstyle='primary', data-style='btn-round', id=renew._id)
                .row

  block script.
    script(src="/admin/custom/all-renew.js")