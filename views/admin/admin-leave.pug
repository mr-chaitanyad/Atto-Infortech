extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold View All leaves
              h5.text-white.op-7.mb-2 Welcome to Atto Infotech
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/leave/admin/add') Add leave
      .page-inner
        .row
          .col-md-12
            .card.card-with-nav
              .card-body
                .row
                  .col-md-4
                    .form-group
                      label(for='from') From
                      // The date range picker element
                      #fromTo(style='background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc; width: 100%')
                        i.fa.fa-calendar
                        span(style="padding: 0 7px;")
                        i.fa.fa-caret-down

                  .col-md-4
                    button.btn.btn-primary#clear_filter(type="button" style='margin-top:26px;')
                      | Clear Filter
                hr
                .table-responsive
                  .col-sm-12
                    table#all-leave.display.table.table-striped.table-hover.dataTable
                      thead
                        tr
                          th Employee Name
                          th Leave start
                          th Leave end
                          th Total day(s)
                          th Reason
                          th Date Range
                          th Leaves Allow

                      // --- MISSING TBODY BLOCK ADDED HERE ---
                      tbody
                        each leave in leaves
                          tr
                            // Column 1: Employee Name (populated field)
                            td #{leave.employee_id.name}  (#{leave.remainingLeaves})
                            // Column 2: Leave start (formatted object field)
                            td #{leave.leave_start_obj.ll}
                            // Column 3: Leave end (formatted object field)
                            td #{leave.leave_end_obj.ll}
                            // Column 4: Total day(s)
                            td #{leave.total_days} days
                            // Column 5: Reason
                            td #{leave.leave_reason || 'N/A'}
                            // Column 6: Date Range (from populated employee object)
                            td #{leave.formattedDateRange || 'N/A'}
                            // Column 7: Leaves Allow (from populated employee object)
                            td #{leave.employee_id.leaveAllow || 0}

  block scripts
    console.log(leaves)
    script(type='text/javascript' src='https://cdn.jsdelivr.net/momentjs/latest/moment.min.js')
    script(type='text/javascript' src='https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js')
    script(type='text/javascript' src='/admin/assets/js/admin-leave.js')