extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold View All Sub Tasks
              h5.text-white.op-7.mb-2 Welcome to Admin Panel
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/project/add/sub/task') Add Sub Tasks
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/dashboard') Dashboard
      .page-inner
        .row
          .col-md-12
            .card.card-with-nav
              .card-body
                //- +searchUsers()
                //- pre= h.dump(subTasks[0])
                .table-responsive
                  .col-sm-12
                    table#basic-datatables.display.table.table-striped.table-hover.dataTable(role='grid', aria-describedby='basic-datatables_info')
                      thead
                        tr(role='row')
                          th Sub Task Name
                          th Project Assigned
                          th Status
                          th Action
                      tbody
                        each subTask in subTasks
                          a(href="#")
                            tr.odd(role='row')
                              td.sorting_1 #{subTask.sub_task}
                              td #{subTask.project_id.name}
                              td #{subTask.status == 'active' ? 'Active' : 'Inactive'}
                              td
                                a.btn.btn-link.btn-primary(href=`/admin/project/edit/sub/task/${subTask._id}`)
                                    i.fa.fa-edit
                .row

  script.
    $(document).ready(function() {
      $('#basic-datatables').DataTable({
        ordering: false,
        pageLength: 100
      });
    });
