extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              if project_id
                h2.text-white.pb-2.fw-bold Add Sub Task for
                  strong  #{selProject.name}
              else
                h2.text-white.pb-2.fw-bold Add Sub Task
              h5.text-white.op-7.mb-2 Welcome to Atto Infotech
      .page-inner
        .row
          .col-md-12
            //- pre= h.dump(project_id)
            .card.card-with-nav
              form(action="/admin/project/add/sub/task", method="POST")
                .card-body
                  .col-md-12
                    .form-group(style="margin-bottom: 20px;")
                      if project_id
                        input.form-control(type='hidden' id="sel_proj_id" style="height: 30px !important;" name='project_id' required="" value=project_id)
                        input.form-control(type='text' id="sel_proj_name" style="height: 30px !important;" required="" value=selProject.name disabled)
                      else
                        label(for='exampleFormControlSelect') Select Project
                        select#dropdown1.form-control.select2(name='project_id' class="sel_proj" required)
                          option(value='') Select Project
                          each project in projects
                            option(value=project._id) #{project.name}
                  .table-responsive
                    .col-sm-12
                      table#addmoreTable.display.table.table-bordered(role='grid', aria-describedby='basic-datatables_info')
                          thead
                            tr
                              th Sub Task
                              th.w-25
                                button.btn.btn-primary.btn-sm.addmore(type="button") Add more sub task
                          tbody
                            tr(tr_count = 0)
                              td
                                textarea(name="sub_task[0]" placeholder="Enter sub task" style="height: 32px; width: 100%; border: 1px solid rgb(235, 237, 242); margin-top: 3px; border-radius: 5px;" required)
                  .card-action
                    .row
                      .col-md-12
                        if project_id
                          button.btn.btn-primary(type="submit") Add Sub Task for
                            strong  #{selProject.name}
                        else
                          button.btn.btn-primary(type="submit") Add Sub Task
                .row
  block script
    script(type='text/javascript' src='https://cdn.jsdelivr.net/momentjs/latest/moment.min.js')
    script(type='text/javascript' src='https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js')
    script(src='/admin/custom/add-sub-task.js')

  script.
    var allProjectsObj = !{JSON.stringify(projects)};