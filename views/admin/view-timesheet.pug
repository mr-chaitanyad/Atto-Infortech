    function swall(text) {
      var SweetAlert2Demo = function () {
        //== Demos
        var initDemos = function () {
          swal(text, {
            buttons: false,
            timer: 2000,
            backdrop:true,
            closeOnClickOutside: false,
            closeOnEsc: false
          })
        };
        return {
            //== Init
            init: function () {
              initDemos();
            },
          };
        }();
      jQuery(document).ready(function () {
        SweetAlert2Demo.init();
      });
    }

    function reloadPage() {
      window.location.reload();
    }

    function redirectToEditTimesheet (timesheet_id) {
      window.location.href = `/admin/timesheet/edit/${timesheet_id}`;
    }