extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold Timesheet
              h5.text-white.op-7.mb-2 Welcome to Atto Infotech
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/timesheet/create') Add
      .page-inner
        .row
          .col-md-12
            .card.card-with-nav
              .card-body(style="padding-top: 0px !important;")
                .row
                  .col-md-4
                    .form-group
                      label(for='from') From
                      //- input#fromTo(type='text' name='from')
                      #fromTo(style='background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc; width: 100%')
                        i.fa.fa-calendar
                        span(style="padding: 0 7px;")
                        i.fa.fa-caret-down
                  .col-md-3
                    .form-group
                      label(for='exampleFormControlSelect') Select Project
                      select#dropdown1.form-control.select2(name='theme')
                        option(value='') Select Project
                        each project in projects
                          option(value=`${project.project_id.name}`) #{project.project_id.name}
                  .col-md-2
                    button.btn.btn-primary#clear_filter(type="button" style='margin-top:26px;')
                      | Clear Filter
                  .col-md-2
                hr
                .table-responsive
                  .col-sm-12
                    table#all-timesheet.display.table.table-striped.table-hover.dataTable(role='grid', aria-describedby='basic-datatables_info')
                      thead
                        tr(role='row')
                          th Project Name
                          th Worked Date
                          th Worked Hour
                          th Note
                          th Action
                      tbody
                        //- each timesheet in timesheets
                          a(href="#")
                            tr.odd(role='row')
                              td.sorting_1 #{timesheet.project_id.name}
                              td #{timesheet.worked_date_obj.ll}
                              td #{timesheet.worked_hour} hour
                              td #{timesheet.notes ? timesheet.notes : "Not Provided"}
                              td
                                button.btn.btn-link.btn-primary(type='button' data-toggle='tooltip' title="Edit timesheet" data-original-title="Edit timesheet" onclick=`redirectToEditTimesheet('${timesheet._id}')`)
                                  i.fa.fa-edit
                .row
  block script
    script(type='text/javascript' src='https://cdn.jsdelivr.net/momentjs/latest/moment.min.js')
    script(type='text/javascript' src='https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js')

  script.
    $(document).ready(function () {
      var tbl = $('#all-timesheet').DataTable({
        bProcessing: true,
        bServerSide: true,
        pagination: true,
        sAjaxSource: "/admin/timesheet/jq/emp/record",
        fnServerParams: function ( data ) {
          //- data.push({ "name": "more_data", "value": "my_value" })
          var startDatee;
          var endDatee;
          var dates = $('#fromTo span').html();
          if (dates) {
            console.log('not empty');
            startDatee = moment(new Date(dates.split("-")[0])).format("DD/MM/YYYY");
            endDatee = moment(new Date(dates.split("-")[1])).format("DD/MM/YYYY");
            data.push( { "name": "start", "value": startDatee }, { "name": "end", "value": endDatee } );
          } else {
            console.log('empty');
          }
        }
      });

      var start = moment();
      var end = moment();

      $('#dropdown1').on('change', function () {
        tbl
          .columns(0)
          .search(this.value)
          .draw();
      });

      $('#dropdown1').select2({
        type: 'bootstrap'
      });

      $('#clear_filter').click(function () {
        tbl
          .search('')
          .columns().search('')
          .draw();

        $('#dropdown1').val('').change();
        $('#dropdown2').val('').change();
        $('#fromTo span').html("");
        //- tbl.ajax.reload();
      })

      $('#fromTo').on('cancel.daterangepicker', function(ev, picker) {
        //do something, like clearing an input
        $('#fromTo span').html("");
        tbl.draw();
      });

      $('#fromTo').daterangepicker({
        startDate: start,
        endDate: end,
        autoUpdateInput: false,
        locale: {
          cancelLabel: 'Clear'
        }
      }, cb);

      function cb(start, end) {
        $('#fromTo span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
        let startDate = {
          year: parseInt(start.format('YYYY')),
          month: parseInt(start.format('MM')),
          date: parseInt(start.format('DD'))
        };
        let endDate = {
          year: parseInt(end.format('YYYY')),
          month: parseInt(end.format('MM')),
          date: parseInt(end.format('DD'))
        };

        swall("Please wait...");

        $.ajax({
          type: 'POST',
          url: `/admin/timesheet/filter/by/date`,
          dataType: "json",
          data: {
            start: startDate,
            end: endDate
          },
          success: function(result) {
            console.log(result);
            if (result.code == 200) {
              swal.close();
              tbl.clear().rows.add(result.data.newArr).draw();
              return;
            } else if (result.code == 309) {
              swal.close();
              swall("Something went wrong. Try again later!");
            } else if (result.code == 401) {
              swall("Something went wrong. Try again later!");
            } else {
              swal.close();
              notifyy("Something went wrong! Try again later.", "danger");
            }
          }
        })
      }

