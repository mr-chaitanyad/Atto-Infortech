extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold Update Warehouse
              h5.text-white.op-7.mb-2 Welcome to Admin Panel
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/warehouse/all') All Warehouses
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/dashboard') Dashboard
      .page-inner
        .row
          .col-md-12
            .card
              form(action=`/admin/warehouse/edit/${warehouse._id}`, method="POST")
                .card-body
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Name
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='text', name='name', placeholder='Enter Name', value=warehouse.name, required='')
                      //- small#emailHelp.form-text.text-muted We'll never share your email with anyone else.
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='Mobile No.')
                      | Mobile No.
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='text', name='mobile', placeholder='Enter Mobile No.', value=warehouse.mobile, required="")
                  .form-group.form-show-validation.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='email')
                      | Address 1
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#email.form-control(type='text', name='address_1', placeholder='Enter Address 1', value=warehouse.address_1 required='')
                  .form-group.form-show-validation.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='email')
                      | Address 2
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      input#email.form-control(type='text', name='address_2', placeholder='Enter Address 2', value=warehouse.address_2)
                  .form-group.form-show-validation.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='email')
                      | Address 3
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      input#email.form-control(type='text', name='address_3', placeholder='Enter Address 3', value=warehouse.address_3)
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='Mobile No.')
                      | State
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      .select2-input
                        select#state-id.form-control(name='state')
                          if warehouse.state == '0'
                            option(value="0") -- Select --
                              each state in states
                                option(value=state.id) #{state.state_name}
                          else
                            option(value="0") -- Select --
                              each state in states
                                option(value=state.id selected=(state.id == warehouse.state)) #{state.state_name}
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='Mobile No.')
                      | City
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      select#city-id.form-control(name='city')
                        if warehouse.city == '0'
                          option(value='0') -- Select --
                        else
                          each city in cities
                            option(value=city.id selected=(city.id == warehouse.city)) #{city.city_name}
                  //- .form-group.form-show-validation.row
                  //-   label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='user_type')
                  //-     | User Type
                  //-   .col-lg-7.col-md-9.col-sm-8
                  //-     .select2-input
                  //-       select#state.form-control(name='user_type', required='')
                  //-         option(value='user') User
                  //-         option(value='admin') Admin
                  .form-group.form-show-validation.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='status')
                      | Status
                    .col-lg-7.col-md-9.col-sm-8
                      .select2-input
                        select#state.form-control(name='status', required='')
                          option(value='active' selected=(warehouse.status == 'active' ? 'selected' : null)) Active
                          option(value='inactive' selected=(warehouse.status == 'inactive' ? 'selected' : null)) Inactive
                .card-action
                  .row
                    .col-md-12
                      button.btn.btn-color(type="submit") Update Warehouse

  block script
    script(src="/admin/custom/add-client.js")