extends layout-admin

block content
  .main-panel
    .container
      .panel-header.bg-primary-gradient
        .page-inner.py-5
          .d-flex.align-items-left.align-items-md-center.flex-column.flex-md-row
            div
              h2.text-white.pb-2.fw-bold Edit Product
              h5.text-white.op-7.mb-2 Welcome to Admin Panel
            .ml-md-auto.py-2.py-md-0
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/product/all') All Products
              a.btn.btn-white.btn-border.btn-round.mr-2(href='/admin/dashboard') Dashboard
      .page-inner
        .row
          .col-md-12
            .card
              //- pre= h.dump(product)
              form(action=`/admin/product/edit/${product._id}`, method="POST")
                .card-body
                  .form-group.form-show-validation.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right
                      | Is it a spare or product?
                      span.required-label *
                    .col-lg-4.col-md-9.col-sm-8.d-flex.align-items-center
                      .custom-control.custom-radio
                        input#spare.custom-control-input(type='radio' name='is_spare' value="spare" checked=(product.is_spare == 'spare' ? true : false) disabled="disabled")
                        label.custom-control-label(for='spare') Spare
                      .custom-control.custom-radio
                        input#product.custom-control-input(type='radio' name='is_spare' value="product" checked=(product.is_spare == 'product' ? true : false) disabled="disabled")
                        label.custom-control-label(for='product') Product
                  if product.is_spare == 'spare'
                    .form-group.form-show-validation.row.product-sel
                        label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='prod')
                          | Product Selection
                        .col-lg-7.col-md-9.col-sm-8
                          .select2-input
                            select#multiple-states.form-control(name='categories', multiple='multiple')
                              each product in products
                                option(value=product._id) #{product.name}
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Name
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='text', name='name', placeholder='Enter Name', value=product.name, required='')
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Alternate Name
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='text', name='alt_name', placeholder='Enter Alternate Name', value=product.alt_name)
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Price
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='number', name='price', placeholder='Enter Price', value=product.price, required='')
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Threshold
                      span.required-label *
                    .col-lg-7.col-md-9.col-sm-8
                      input#name.form-control(type='number', name='threshold', placeholder='Enter threshold', value=product.threshold, required='')
                  .form-group.row
                    label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='name')
                      | Description
                      span.required-label
                    .col-lg-7.col-md-9.col-sm-8
                      textarea.form-control(name="desc" rows="4" cols="50")= product.desc
                  .form-group.form-show-validation.row
                      label.col-lg-3.col-md-3.col-sm-4.mt-sm-2.text-right(for='prod')
                        | Status
                      .col-lg-7.col-md-9.col-sm-8
                        .select2-input
                          select.form-control(name='status', required='')
                            option(value='active' selected=(product.status == 'active' ? 'selected' : null)) Active
                            option(value='inactive' selected=(product.status == 'inactive' ? 'selected' : null)) Inactive
                  if product.is_spare == 'spare'
                    .table-responsive(style="padding-top: 60px;")
                      .col-sm-12
                        table#addmoreTable.display.table.table-bordered(role='grid', aria-describedby='basic-datatables_info')
                          thead
                            tr
                              th.w-25 Warehouse
                              th Quantity
                              th
                                button.btn.btn-primary.btn-sm.addmore(type="button") Add more
                          tbody
                            each stock, i in product.stocks
                              tr(tr_count = i)
                                td(style="display:none;")
                                  input.form-control(type='text' style="height: 30px !important; border-color: rgba(0, 0, 0, 0.48)" name='id' value=stock._id readonly)
                                td
                                  select.form-control.state(name='warehouse', id="state0" style="height: 20px !important", required='')
                                    option(value="") --- Select Warehouse ---
                                    each warehouse in warehouses
                                      option(value=warehouse._id selected=(warehouse._id.toString() == stock.warehouse_id._id.toString())) #{warehouse.name}
                                td
                                  input.form-control.custom-input(type='number' style="height: 30px !important; border-color: rgba(0, 0, 0, 0.48)" name='qty' value=stock.qty)
                                td
                                  button.btn.btn-danger.btn-sm.remove(type="button" disabled) Remove
                .card-action
                  .row
                    .col-md-12
                      button.btn.btn-color(type="submit") Update Product

  block script
    script(src='/admin/custom/edit-product.js')

  script.
    var warehouseObj = !{JSON.stringify(warehouses)};
    var productObj = !{JSON.stringify(product)};